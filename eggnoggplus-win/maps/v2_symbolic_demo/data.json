{
  "format": "eggnogg-map/v2",
  "id": "v2_symbolic_demo",
  "name": "V2 Symbolic Tile Demo",
  "author": "Eggnogg+",
  "description": "Runtime acceptance fixture for simple visual/collision tiles plus rollback-safe spring and fan behavior in map.lua.",
  "sort_order": 1000,
  "rules": {
    "mode": "swords",
    "round_end_rooms": "inner_only",
    "score_target": null,
    "armed_respawn_limit": 4
  },
  "layout": {
    "kind": "mirrored_source_rooms",
    "room_format": "vanilla_33x12",
    "order": ["center", "outer"]
  },
  "tileset": {
    "sprite_sheet": "tiles.png",
    "cell_w": 16,
    "cell_h": 16,
    "padding": 0,
    "native_layout": true,
    "tiles": [
      {
        "id": "external_green_animation",
        "symbol": "$",
        "name": "External green animation",
        "collision": "solid",
        "sprite_index": 2,
        "frame_count": 3,
        "frame_ticks": 8,
        "animation": "ping_pong",
        "layer": 0,
        "mirror_with_room": true,
        "random_phase": true,
        "scale_x": 1.15,
        "scale_y": 1.15,
        "tint": [0.25, 1.0, 0.35, 1.0]
      },
      {
        "id": "builtin_orange_transform",
        "symbol": "%",
        "name": "Built-in orange transform",
        "native_glyph": "x",
        "sprite_sheet": "builtin:tiles",
        "sprite_index": 4,
        "frame_count": 3,
        "frame_ticks": 12,
        "animation": "loop",
        "layer": 1,
        "mirror_with_room": true,
        "offset_x": -8,
        "offset_y": -2,
        "scale_x": 0.8,
        "scale_y": 1.35,
        "angle_degrees": 12,
        "tint": [1.0, 0.3, 0.15, 0.95]
      },
      {
        "id": "spring_pad",
        "symbol": ">",
        "name": "Scripted spring pad",
        "collision": "solid",
        "native_visual": "underlay",
        "sprite_index": 128,
        "layer": 0,
        "tint": [1.0, 0.85, 0.2, 1.0]
      },
      {
        "id": "mirrored_fan",
        "symbol": "}",
        "name": "Scripted mirrored fan",
        "collision": "pass_through",
        "sprite_sheet": "builtin:tiles",
        "sprite_index": 4,
        "layer": 0,
        "mirror_with_room": true,
        "tint": [0.55, 0.75, 1.0, 0.9]
      },
      {
        "id": "intentional_native_fallback",
        "symbol": "&",
        "name": "Intentional native fallback",
        "native_glyph": "x",
        "sprite_sheet": "builtin:tiles",
        "sprite_index": 999999,
        "layer": 0,
        "tint": [0.2, 0.4, 1.0, 1.0]
      }
    ]
  },
  "rooms": {
    "center": {
      "ambient": "dust"
    },
    "outer": {
      "ambient": "boil"
    }
  }
}
